{
  "name": "maplestory-classic-guide",
  "productName": "מדריך מייפל סטורי קלאסי",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/maori30/maplestory-classic-guide.git"
  },
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.maplestory.classicguide",
    "productName": "מדריך מייפל סטורי קלאסי",
    "publish": [
      {
        "provider": "github",
        "owner": "maori30",
        "repo": "maplestory-classic-guide"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "electron-builder": "^26.6.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^6.0.1"
  }
}
